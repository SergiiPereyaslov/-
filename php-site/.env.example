# Приклад бойового налаштування SmartEcoPack.
#
# Скопіювати в .env, заповнити порожні значення, згенерувати ключ:
#   cp .env.example .env && php artisan key:generate
#
# Файл .env містить паролі й токени: він у .gitignore і має лежати з
# правами 640, власник — користувач, від якого працює PHP-FPM.

APP_NAME=SmartEcoPack
APP_ENV=production
# Заповнює php artisan key:generate. Без ключа не читаються сесії й
# cookie: усі вони зашифровані саме ним. Зміна ключа розлогінює всіх.
APP_KEY=
# На проді завжди false. true віддає відвідувачу трасування стека з
# іменами файлів, запитами й фрагментами .env — це найдешевший спосіб
# віддати зловмиснику карту застосунку.
APP_DEBUG=false
APP_URL=https://smartecopack.com.ua

APP_LOCALE=uk
APP_FALLBACK_LOCALE=uk
APP_FAKER_LOCALE=uk_UA

# Канонічний домен: з нього будуються canonical, hreflang, sitemap і
# посилання в листах. Без завершального слеша.
SITE_URL=https://smartecopack.com.ua

# Вартість bcrypt. 12 — поточний розумний мінімум; менше ставити не
# можна, більше має сенс лише на швидкому процесорі.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# На проді debug писав би в лог кожен SQL-запит разом зі значеннями —
# зокрема телефонами із заявок
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smartecopack
# Окрема роль тільки для застосунку: не postgres і не власник схеми.
# Права — SELECT/INSERT/UPDATE/DELETE на таблиці, без CREATE і DROP.
DB_USERNAME=smartecopack_app
DB_PASSWORD=
# Якщо база на іншому хості — require або verify-full, не disable
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Обов'язково true на https: інакше cookie сесії адміністратора
# поїде відкритим текстом при першому ж запиті на http
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

# Пошта для заявок. Зазвичай SMTP свого домену, не сторонній Gmail.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="site@smartecopack.com.ua"
MAIL_FROM_NAME="${APP_NAME}"
# Куди падають заявки з сайту. Кілька адрес — через кому.
LEAD_EMAIL_TO=

# Дублювання заявок у Telegram. Порожній токен просто вимикає канал —
# заявка все одно збережеться в базі й піде поштою.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# A/B-тест навігації. false — усі бачать варіант «b».
AB_TEST_ENABLED=false

# Google Analytics. Порожньо — лічильник не підключається взагалі,
# і CSP не відкриває доступ до googletagmanager.com.
GA_ID=

VITE_APP_NAME="${APP_NAME}"

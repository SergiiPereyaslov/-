<%- include('partials/head', { title }) %>
<%- include('partials/nav') %>

<div class="page-head">
  <h1>Зміна пароля</h1>
</div>

<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
<% if (saved) { %><div class="alert alert-ok">Пароль змінено.</div><% } %>

<form method="post" action="/settings/password" class="card form-narrow">
  <label class="block">
    <span>Поточний пароль</span>
    <input type="password" name="current" required autocomplete="current-password">
  </label>
  <label class="block">
    <span>Новий пароль</span>
    <input type="password" name="next" required autocomplete="new-password" placeholder="мінімум 4 символи">
  </label>
  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Змінити пароль</button>
  </div>
</form>

<%- include('partials/foot') %>

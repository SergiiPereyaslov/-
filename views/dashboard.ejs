<%- include('partials/head', { title }) %>
<%- include('partials/nav') %>

<% if (!company.name) { %>
  <div class="alert alert-warn">
    <strong>Почніть із реквізитів.</strong> Заповніть дані вашого ТОВ, щоб виставляти рахунки.
    <a href="/settings" class="alert-link">Перейти до реквізитів →</a>
  </div>
<% } %>

<div class="page-head">
  <h1>Вітаємо, <%= user.full_name %>!</h1>
  <a href="/invoices/new" class="btn btn-primary">+ Виставити рахунок</a>
</div>

<div class="cards">
  <div class="card stat">
    <div class="stat-label">Рахунків за <%= year %> рік</div>
    <div class="stat-value"><%= stats.cnt %></div>
  </div>
  <div class="card stat">
    <div class="stat-label">На суму</div>
    <div class="stat-value"><%= fmt.formatMoney(stats.sum_all) %> ₴</div>
  </div>
  <div class="card stat stat-ok">
    <div class="stat-label">Оплачено</div>
    <div class="stat-value"><%= fmt.formatMoney(stats.sum_paid) %> ₴</div>
  </div>
  <div class="card stat stat-warn">
    <div class="stat-label">Очікує оплати</div>
    <div class="stat-value"><%= fmt.formatMoney(stats.sum_unpaid) %> ₴</div>
  </div>
</div>

<div class="grid-2">
  <section class="card">
    <div class="card-head">
      <h2>Останні рахунки</h2>
      <a href="/invoices" class="link">Усі рахунки →</a>
    </div>
    <% if (recent.length === 0) { %>
      <p class="muted pad">Ще немає жодного рахунку. <a href="/invoices/new">Створити перший →</a></p>
    <% } else { %>
      <table class="table">
        <thead>
          <tr><th>Номер</th><th>Дата</th><th>Покупець</th><th class="right">Сума</th><th>Статус</th></tr>
        </thead>
        <tbody>
          <% recent.forEach(function(inv) { %>
            <tr onclick="location.href='/invoices/<%= inv.id %>'" class="clickable">
              <td><strong><%= inv.number %></strong></td>
              <td class="nowrap"><%= fmt.formatDateUk(inv.invoice_date) %></td>
              <td><%= inv.client_name %></td>
              <td class="right nowrap"><%= fmt.formatMoney(inv.total) %> ₴</td>
              <td>
                <% if (inv.status === 'paid') { %>
                  <span class="badge badge-ok">Оплачено</span>
                <% } else { %>
                  <span class="badge badge-warn">Не оплачено</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </section>

  <section class="card">
    <div class="card-head"><h2>Швидкі дії</h2></div>
    <div class="quick-actions">
      <a href="/invoices/new" class="qa"><span class="qa-ico">🧾</span><span>Новий рахунок</span></a>
      <a href="/clients/new" class="qa"><span class="qa-ico">👤</span><span>Додати покупця</span></a>
      <a href="/services/new" class="qa"><span class="qa-ico">📦</span><span>Додати послугу</span></a>
      <a href="/settings" class="qa"><span class="qa-ico">🏢</span><span>Реквізити</span></a>
    </div>
    <div class="mini-stats">
      <div><span class="muted">Покупців у базі:</span> <strong><%= counts.clients %></strong></div>
      <div><span class="muted">Товарів/послуг:</span> <strong><%= counts.services %></strong></div>
    </div>
  </section>
</div>

<%- include('partials/foot') %>

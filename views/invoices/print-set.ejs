<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Комплект: рахунок і накладна № <%= invoice.number %></title>
  <link rel="stylesheet" href="/static/css/print-set.css">
</head>
<body class="doc-scope">
  <div class="toolbar no-print">
    <button onclick="window.print()" class="pbtn">🖨 Друкувати / Зберегти PDF</button>
    <a href="/invoices/<%= invoice.id %>" class="pback">← Назад</a>
    <span class="hint">2 аркуші А4: рахунок ×2 та видаткова накладна ×2 (по два А5 на аркуш). У друку вимкніть поля або оберіть «за замовчуванням».</span>
  </div>

  <!-- Аркуш А4 №1 — два рахунки -->
  <div class="a4-page">
    <div class="a5-slot"><%- include('_doc_rahunok') %></div>
    <div class="a5-cut"></div>
    <div class="a5-slot"><%- include('_doc_rahunok') %></div>
  </div>

  <!-- Аркуш А4 №2 — дві видаткові накладні -->
  <div class="a4-page">
    <div class="a5-slot"><%- include('_doc_nakladna') %></div>
    <div class="a5-cut"></div>
    <div class="a5-slot"><%- include('_doc_nakladna') %></div>
  </div>

  <% if (autoprint) { %>
    <script>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 300); });</script>
  <% } %>
</body>
</html>

<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Комплект документів № <%= invoice.number %></title>
  <link rel="stylesheet" href="/static/css/print-set.css">
</head>
<body class="doc-scope">
  <div class="toolbar no-print">
    <button onclick="window.print()" class="pbtn">🖨 Друкувати / Зберегти PDF</button>
    <a href="/invoices/<%= invoice.id %>" class="pback">← Назад</a>
    <span class="hint">
      <% if (contract) { %>Договір на повних А4, далі 2 аркуші А4: рахунок ×2 та накладна ×2 (по два А5 на аркуш).
      <% } else { %>2 аркуші А4: рахунок ×2 та видаткова накладна ×2 (по два А5 на аркуш).<% } %>
      У друку вимкніть поля або оберіть «за замовчуванням».
    </span>
  </div>

  <% if (contract) { %>
    <!-- Договір — на повних аркушах А4 -->
    <div class="a4-page a4-full">
      <%- include('_doc_contract', { contract, fmt }) %>
    </div>
  <% } %>

  <!-- Аркуш А4 — два рахунки -->
  <div class="a4-page">
    <div class="a5-slot"><%- include('_doc_rahunok') %></div>
    <div class="a5-cut"></div>
    <div class="a5-slot"><%- include('_doc_rahunok') %></div>
  </div>

  <!-- Аркуш А4 — дві видаткові накладні -->
  <div class="a4-page">
    <div class="a5-slot"><%- include('_doc_nakladna') %></div>
    <div class="a5-cut"></div>
    <div class="a5-slot"><%- include('_doc_nakladna') %></div>
  </div>

  <% if (autoprint) { %>
    <script>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 300); });</script>
  <% } %>
</body>
</html>

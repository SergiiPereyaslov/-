<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <style>
    html, body { margin: 0; height: 100%; }
    body { display: flex; flex-direction: column; }
    .oo-header {
      flex: none;
      padding: 6px 12px;
      background: #fff; border-bottom: 1px solid #d7dce6;
      font: 13px -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    }
    .oo-back { color: #2563eb; text-decoration: none; }
    #editor { flex: 1 1 auto; min-height: 0; }
  </style>
</head>
<body>
  <div class="oo-header"><a href="<%= cardBackUrl %>" class="oo-back">← До картки замовника</a></div>
  <div id="editor"></div>

  <script src="<%= documentServerUrl %>/web-apps/apps/api/documents/api.js"></script>
  <script>
    new DocsAPI.DocEditor("editor", <%- JSON.stringify(config) %>);
  </script>
</body>
</html>

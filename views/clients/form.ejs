<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>

<div class="page-head">
  <h1><%= title %></h1>
  <a href="/clients" class="btn btn-ghost">← До списку</a>
</div>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-error"><%= error %></div>
<% } %>

<form method="post" action="<%= action %>" class="card form-narrow">
  <label class="block">
    <span>Назва замовника <span class="req">*</span></span>
    <input type="text" name="name" value="<%= inst.name || '' %>" required autofocus placeholder="Повна назва замовника">
  </label>

  <div class="form-grid-2">
    <label>
      <span>Код</span>
      <input type="text" name="code" value="<%= inst.code || '' %>" placeholder="Напр.: 2799">
    </label>
    <label>
      <span>Коротка назва</span>
      <input type="text" name="short_name" value="<%= inst.short_name || '' %>" placeholder="Напр.: ДНУ">
    </label>
  </div>

  <label class="block">
    <span>Категорія</span>
    <input type="text" name="category" value="<%= inst.category || '' %>" list="catList" placeholder="Напр.: Заклад вищої освіти">
    <datalist id="catList">
      <option value="Заклад вищої освіти"></option>
      <option value="Заклади фахової передвищої освіти"></option>
    </datalist>
  </label>

  <details class="more-fields">
    <summary>Додаткові реквізити (необов’язково)</summary>
    <div class="more-body">
      <div class="form-grid-2">
        <label>
          <span>Код ЄДРПОУ</span>
          <input type="text" name="edrpou" value="<%= inst.edrpou || '' %>">
        </label>
        <label>
          <span>Контактна особа</span>
          <input type="text" name="contact_person" value="<%= inst.contact_person || '' %>">
        </label>
      </div>
      <label class="block">
        <span>Адреса</span>
        <input type="text" name="address" value="<%= inst.address || '' %>">
      </label>
      <div class="form-grid-2">
        <label>
          <span>Телефон</span>
          <input type="text" name="phone" value="<%= inst.phone || '' %>">
        </label>
        <label>
          <span>Email</span>
          <input type="text" name="email" value="<%= inst.email || '' %>">
        </label>
      </div>
    </div>
  </details>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Зберегти</button>
    <a href="/clients" class="btn btn-ghost">Скасувати</a>
  </div>
</form>

<%- include('../partials/foot') %>

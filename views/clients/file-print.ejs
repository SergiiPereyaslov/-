<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/static/css/print.css">
  <style>
    body { margin: 0; }
    .doc-frame { display: block; width: 100%; height: calc(100vh - 54px); border: none; }
    .doc-image-wrap { text-align: center; padding: 16px; }
    .doc-image-wrap img { max-width: 100%; }
  </style>
</head>
<body>
  <div class="toolbar no-print">
    <button onclick="window.print()" class="pbtn">🖨 Друкувати</button>
    <span class="hint">Кількість копій — у вікні друку браузера</span>
  </div>

  <% if (isImage) { %>
    <div class="doc-image-wrap"><img src="<%= fileUrl %>" alt=""></div>
  <% } else { %>
    <embed src="<%= fileUrl %>" type="application/pdf" class="doc-frame">
  <% } %>

  <script>
    window.addEventListener('load', function () {
      setTimeout(function () { window.print(); }, 400);
    });
  </script>
</body>
</html>

# Запуск без Docker: systemd-юніт для збірки в .next/standalone.
#
#   sudo cp deploy/smartecopack.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now smartecopack
#
# Змінні оточення — в /etc/smartecopack.env з правами 600 (там паролі БД,
# токен Telegram і доступ до SMTP).

[Unit]
Description=SmartEcoPack website
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=smartecopack
Group=smartecopack
WorkingDirectory=/srv/smartecopack/current
EnvironmentFile=/etc/smartecopack.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5

# Обмеження прав: застосунку не потрібен доступ ані до /home, ані до пристроїв
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/smartecopack/current/.next/cache
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=smartecopack

[Install]
WantedBy=multi-user.target
